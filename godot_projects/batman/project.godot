; Engine configuration file for Batman: Gotham Duo (Sunsoft Remake)
config_version=5

[application]

config/name="Batman: Gotham Duo"
config/description="Sunsoft 1989 Batman Remake with 2-Player Co-Op and AI Companion"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=256
window/size/viewport_height=240
window/size/window_width_override=768
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
