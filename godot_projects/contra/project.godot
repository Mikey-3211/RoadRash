; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by text.

config_version=5

[application]

config/name="Contra Godot Arcade"
config/description="Faithful re-creation of Konami's Contra using Godot 4.7 Engine"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=256
window/size/viewport_height=224
window/size/window_width_override=768
window/size/window_height_override=672
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
