{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/games/hotd2/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].js"
    },
    {
      "src": "/classic/cd4bef5efafb3ec7/(.*)",
      "dest": "/classic/cd4bef5efafb3ec7/$1"
    },
    {
      "src": "/classic-assets/414a4427a4dcdcc4/(.*)",
      "dest": "/classic-assets/414a4427a4dcdcc4/$1"
    },
    {
      "src": "/games/road-rash/?$",
      "dest": "/games/road-rash/index.html"
    },
    {
      "src": "/games/dangerous-dave/?$",
      "dest": "/games/dangerous-dave/index.html"
    },
    {
      "src": "/games/vcop2/?$",
      "dest": "/games/vcop2/index.html"
    },
    {
      "src": "/games/hotd2/?$",
      "dest": "/games/hotd2/index.html"
    },
    {
      "src": "/games/contra/?$",
      "dest": "/games/contra/index.html"
    },
    {
      "src": "/games/batman/?$",
      "dest": "/games/batman/index.html"
    },
    {
      "src": "/dave/?(.*)",
      "dest": "/dave/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
